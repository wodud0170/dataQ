<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1"
         xmlns:uml="http://schema.omg.org/spec/UML/2.1"
         xmlns:xmi="http://schema.omg.org/spec/XMI/2.1">
  <xmi:Documentation exporter="DataQ test sample" exporterVersion="1.0"/>
  <uml:Model xmi:id="model-001" name="DataQ_Test_Model">
    <packagedElement xmi:type="uml:Package" xmi:id="pkg-001" name="HR">

      <packagedElement xmi:type="uml:Class" xmi:id="cls-employee" name="EMPLOYEE">
        <ownedAttribute xmi:type="uml:Property" xmi:id="attr-emp-id" name="EMP_ID" isID="true">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
          <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="attr-emp-name" name="EMP_NAME">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
          <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="attr-emp-email" name="EMAIL">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
          <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="attr-emp-dept" name="DEPT_ID" type="cls-department">
          <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
        </ownedAttribute>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="cls-department" name="DEPARTMENT">
        <ownedAttribute xmi:type="uml:Property" xmi:id="attr-dept-id" name="DEPT_ID" isID="true">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
          <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="attr-dept-name" name="DEPT_NAME">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
          <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
        </ownedAttribute>
      </packagedElement>

    </packagedElement>

    <packagedElement xmi:type="uml:Package" xmi:id="pkg-002" name="SALES">
      <packagedElement xmi:type="uml:Class" xmi:id="cls-customer" name="CUSTOMER">
        <ownedAttribute xmi:type="uml:Property" xmi:id="attr-cust-id" name="CUST_ID" isID="true">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
          <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="attr-cust-name" name="CUST_NAME">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
          <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="attr-cust-phone" name="PHONE">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
          <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
        </ownedAttribute>
      </packagedElement>
    </packagedElement>

  </uml:Model>
</xmi:XMI>
